{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:kidtrack-sql.database.windows.net,1433;Initial Catalog=KidTrackDB;Persist Security Info=False;User ID=kidtrack_admin;Password=YOUR_DB_PASSWORD;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_STRONG_256_BIT_SECRET_KEY_IN_PRODUCTION",
    "Issuer": "KidTrack",
    "Audience": "KidTrackUsers"
  },
  "Firebase": {
    "CredentialsPath": "firebase-service-account.json"
  },
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey=YOUR_APP_INSIGHTS_KEY"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
